# {{.ProjectName}} — environment variables
#
# Copy to `.env` and fill in for local development. Production values live in
# the deploy host's environment (see .github/workflows/deploy.yml).

# Application
APP_ENV=development
ADDR=:3000

# SQLite database file. The directory is created automatically.
DATABASE_URL=./data/{{.ProjectName}}.sqlite3

# Sessions
SESSION_COOKIE_NAME={{.ProjectName}}_session
SESSION_COOKIE_SECURE=false

# Sentry — leave empty to disable error reporting locally.
SENTRY_DSN=

# Postmark — leave the token empty to use the in-memory recorder mailer
# (no real email is sent). Useful for local dev and tests.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
